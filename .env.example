# ============================================================
# Healthcare Tracker — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values marked CHANGE ME.
# Everything else has a safe default and can be left as-is.
# NEVER commit your real .env file.
# ============================================================

# --- Database ---
POSTGRES_USER=healthtracker
POSTGRES_PASSWORD=CHANGE_ME            # CHANGE ME: any strong password
POSTGRES_DB=healthtracker
DATABASE_URL=postgresql+psycopg://healthtracker:CHANGE_ME@db:5432/healthtracker
# ^ Must match POSTGRES_PASSWORD above

# --- Authentication ---
JWT_SECRET=CHANGE_ME                   # CHANGE ME: long random string (e.g. openssl rand -hex 32)
INITIAL_ADMIN_EMAIL=admin@example.com  # CHANGE ME: your email address
INITIAL_ADMIN_PASSWORD=CHANGE_ME       # CHANGE ME: min 12 characters
ACCESS_TOKEN_TTL_MINUTES=15            # Optional: session token lifetime
REFRESH_TOKEN_TTL_DAYS=7               # Optional: remember-me lifetime
COOKIE_SECURE=true                     # Set to false only for local HTTP dev

# --- Backups ---
# Nightly backups are written to this path on the host (created automatically).
# Default keeps backups in a ./backups folder next to your compose file.
BACKUP_HOST_PATH=./backups             # Optional: change to any absolute path

