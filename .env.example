# Copy to .env for local dev. NEVER commit a real .env.

# Postgres
POSTGRES_USER=healthtracker
POSTGRES_PASSWORD=change-me-in-real-env
POSTGRES_DB=healthtracker

# Backend database URL (points at the 'db' service inside the compose network)
DATABASE_URL=postgresql+psycopg://healthtracker:change-me-in-real-env@db:5432/healthtracker

# Auth
# JWT_SECRET: set a long, random secret in production (sessions are signed with it).
# ACCESS/REFRESH TTLs control session lifetimes.
JWT_SECRET=dev-only-insecure-secret-change-in-real-env
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# The first admin is created from these on first startup with an empty database.
# INITIAL_ADMIN_PASSWORD MUST be at least 12 characters or startup will fail.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-in-real-env
# COOKIE_SECURE=true in production (cookies sent only over HTTPS); false for local HTTP dev.
COOKIE_SECURE=false

# Backups (production only — used by docker-compose.prod.yml)
# BACKUP_HOST_PATH: absolute path on the host where nightly backups are written.
# The backup container mounts this path and writes YYYY-MM-DD/ directories to it.
BACKUP_HOST_PATH=/opt/healthcare-backups

# Cloudflare Tunnel (production only — used by docker-compose.prod.yml)
# CLOUDFLARE_TUNNEL_TOKEN: token from your Cloudflare Zero Trust dashboard.
# Leave blank for local dev (the cloudflared service is not in docker-compose.yml).
CLOUDFLARE_TUNNEL_TOKEN=
