FROM python:3.12-slim

WORKDIR /app

# Install app + dev (test) dependencies in one layer.
# Pinned to match pyproject.toml exactly so the image is fully self-contained.
RUN pip install --no-cache-dir \
    "fastapi==0.136.3" \
    "uvicorn[standard]==0.34.0" \
    "sqlalchemy==2.0.36" \
    "psycopg[binary]==3.2.3" \
    "pydantic-settings==2.6.1" \
    "pyjwt==2.13.0" \
    "pwdlib[argon2]==0.3.0" \
    "alembic==1.18.4" \
    "email-validator==2.2.0" \
    "python-multipart==0.0.32" \
    "slowapi==0.1.9" \
    "pytest==8.3.4" \
    "httpx==0.28.1" \
    "freezegun==1.5.1" \
    "filetype==1.2.0"

# Postgres 17 client tools so the backup.sh/restore.sh script tests run for
# real (Debian slim's v15 pg_dump refuses the v17 test server; use PGDG).
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
 && mkdir -p /etc/apt/keyrings \
 && curl -fsSL -o /etc/apt/keyrings/pgdg.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc \
 && echo "deb [signed-by=/etc/apt/keyrings/pgdg.asc] http://apt.postgresql.org/pub/repos/apt $(. /etc/os-release && echo "$VERSION_CODENAME")-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update && apt-get install -y --no-install-recommends postgresql-client-17 \
 && apt-get purge -y curl && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

# Source code is mounted at runtime via docker compose volume (./backend:/app).
# This image only provides the pre-installed environment.
RUN adduser --disabled-password --gecos "" appuser
USER appuser

CMD ["pytest", "-v"]
